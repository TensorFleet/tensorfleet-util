{
  "name": "tensorfleet-util",
  "version": "1.0.0",
  "description": "TensorFleet utilities for drone control and ROS integration",
  "type": "module",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TensorFleet/vscode-tensorfleet.git"
  },
  "keywords": [
    "drone",
    "ros",
    "tensorfleet",
    "mavros"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vacuum/node-runtime": {
      "types": "./dist/vacuum/node-runtime.d.ts",
      "import": "./dist/vacuum/node-runtime.js",
      "default": "./dist/vacuum/node-runtime.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist .typia-build",
    "build": "bun run clean && typia generate --input src --output .typia-build --project tsconfig.json && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typia": "^12.1.1",
    "typescript": "^6.0.3"
  }
}
