{
  "name": "tensorfleet-util",
  "version": "1.0.0",
  "description": "TensorFleet utilities for drone control and ROS integration",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TensorFleet/vscode-tensorfleet.git"
  },
  "keywords": [
    "drone",
    "ros",
    "tensorfleet",
    "mavros"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "ts-patch install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-patch": "^4.0.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "pino": "^10.3.1",
    "typia": "^12.1.1"
  }
}
